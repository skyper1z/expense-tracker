# Copy to .env and fill in from Supabase: Project Settings → API.
# The anon (publishable) key is meant for browsers; row level security protects each user's data.
# Leave both empty to run SpendNote in local-only mode (no sign-in, records stay on the device).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
