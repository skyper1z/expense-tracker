# Secrets for the sign-in Edge Functions.
# Local: copy to supabase/functions/.env (git-ignored).
# Hosted: supabase secrets set AUTHENTICA_API_KEY=... (and the others below)

# Required: API key from the Authentica portal (https://portal.authentica.sa)
AUTHENTICA_API_KEY=

# Optional: numeric email template id from the Authentica dashboard (default template if empty)
AUTHENTICA_EMAIL_TEMPLATE_ID=

# Optional: comma-separated web origins allowed to call the functions (any origin if empty)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
