# Secrets for the sign-in Edge Functions.
# Local: copy to supabase/functions/.env (git-ignored).
# Hosted: supabase secrets set NAME=value ...

# One free email API to deliver the codes (set ONE of these):
#   Brevo  – 300 emails/day free; verify a single sender address, no domain needed. https://www.brevo.com
#   Resend – 3,000 emails/month free; needs your own domain to email anyone. https://resend.com
BREVO_API_KEY=
RESEND_API_KEY=

# Sender shown on the email. Must be an address/domain you verified with the provider above.
EMAIL_FROM=SpendNote <you@example.com>

# Optional: comma-separated web origins allowed to call the functions (any origin if empty)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: secret used to hash codes (defaults to the project's service role key)
OTP_SECRET=
